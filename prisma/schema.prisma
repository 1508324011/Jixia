generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum SpaceKind {
  personal
  shared
}

enum SpaceRole {
  owner
  editor
  viewer
}

enum ProjectStatus {
  active
  archived
}

enum ProjectRole {
  owner
  editor
  viewer
}

enum LibraryEntryVisibility {
  private
  space_shared
  published_to_project
}

enum NoteVisibility {
  private
  space_shared
}

enum PublishState {
  draft
  review
  published
}

enum JobStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  displayName         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  memberships         Membership[]
  importedAssets      PaperAsset[]         @relation("PaperAssetImportedBy")
  notes               Note[]
  readingStates       ReadingState[]
  conversations       Conversation[]
  generatedInsights   GeneratedInsight[]
  notebookDocuments   NotebookDocument[]
  providerCredentials ProviderCredential[]
  jobs                Job[]                @relation("JobRequestedBy")
  auditLogs           AuditLog[]
  createdProjects     Project[]            @relation("ProjectCreatedBy")
  createdProjectDocs  ProjectDoc[]         @relation("ProjectDocCreatedBy")
  projectMemberships  ProjectMember[]
  addedLibraryEntries LibraryEntry[]        @relation("LibraryEntryAddedBy")
}

model Space {
  id           String         @id @default(cuid())
  name         String
  description  String?
  kind         SpaceKind
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  memberships  Membership[]
  jobs         Job[]
  auditLogs    AuditLog[]
  projects     Project[]
}

model Project {
  id              String          @id @default(cuid())
  spaceId         String
  name            String
  description     String?
  status          ProjectStatus   @default(active)
  createdByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  space           Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy       User            @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members         ProjectMember[]
  projectDocs     ProjectDoc[]
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole
  joinedAt  DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Membership {
  id        String    @id @default(cuid())
  spaceId    String
  userId     String
  role       SpaceRole
  joinedAt   DateTime  @default(now())
  space      Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
}

model PaperAsset {
  id              String         @id @default(cuid())
  canonicalId     String         @unique
  title           String
  abstractText    String?
  authors         String?
  sourceType      String
  sourceLocator   String
  storageKey      String?
  checksum        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  importedByUserId String
  importedBy      User           @relation("PaperAssetImportedBy", fields: [importedByUserId], references: [id], onDelete: Restrict)
  libraryEntries  LibraryEntry[]
  generatedInsightEvidenceSpans GeneratedInsightEvidenceSpan[]
  notebookCitations NotebookDocumentCitation[]
  projectDocCitations ProjectDocCitation[]
}

model LibraryEntry {
  id            String                 @id @default(cuid())
  scopeType      String
  scopeId        String
  paperAssetId   String
  addedByUserId  String
  legacySpaceId  String?
  legacyVisibility String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  paperAsset     PaperAsset             @relation(fields: [paperAssetId], references: [id], onDelete: Cascade)
  addedBy        User                   @relation("LibraryEntryAddedBy", fields: [addedByUserId], references: [id], onDelete: Restrict)
  notes          Note[]
  conversations  Conversation[]
  generatedInsights GeneratedInsight[]
  readingStates  ReadingState[]

  @@unique([scopeType, scopeId, paperAssetId], name: "LibraryEntry_scope_asset_unique")
}

model Note {
  id            String         @id @default(cuid())
  libraryEntryId String
  authorUserId   String
  visibility     NoteVisibility
  body           String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  libraryEntry   LibraryEntry    @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)
  author         User            @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
}

model ReadingState {
  id            String        @id @default(cuid())
  libraryEntryId String
  userId         String
  lastOpenedAt   DateTime?
  progress       Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  libraryEntry   LibraryEntry @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([libraryEntryId, userId])
}

model Conversation {
  id             String       @id @default(cuid())
  libraryEntryId String
  userId         String
  title          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  libraryEntry   LibraryEntry @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedInsights GeneratedInsight[]
}

model GeneratedInsight {
  id              String                         @id @default(cuid())
  libraryEntryId  String
  conversationId  String
  createdByUserId String
  summary         String
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  libraryEntry    LibraryEntry                   @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)
  conversation    Conversation                   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy       User                           @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  evidenceSpans   GeneratedInsightEvidenceSpan[]

  @@index([libraryEntryId])
  @@index([conversationId])
}

model GeneratedInsightEvidenceSpan {
  id                 String           @id @default(cuid())
  generatedInsightId String
  paperAssetId       String
  quote              String
  startOffset        Int
  endOffset          Int
  orderIndex         Int
  createdAt          DateTime         @default(now())
  generatedInsight   GeneratedInsight @relation(fields: [generatedInsightId], references: [id], onDelete: Cascade)
  paperAsset         PaperAsset       @relation(fields: [paperAssetId], references: [id], onDelete: Cascade)

  @@unique([generatedInsightId, orderIndex])
  @@index([paperAssetId])
}

model NotebookDocument {
  id        String                    @id @default(cuid())
  ownerId   String
  title     String
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  owner     User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions  NotebookDocumentVersion[]
}

model NotebookDocumentVersion {
  id                 String                     @id @default(cuid())
  notebookDocumentId String
  versionNumber      Int
  snapshot           String
  createdAt          DateTime                   @default(now())
  notebookDocument   NotebookDocument           @relation(fields: [notebookDocumentId], references: [id], onDelete: Cascade)
  citations          NotebookDocumentCitation[]

  @@unique([notebookDocumentId, versionNumber])
}

model NotebookDocumentCitation {
  id                        String                  @id @default(cuid())
  notebookDocumentVersionId String
  paperAssetId              String
  evidenceSpan              String?
  createdAt                 DateTime                @default(now())
  notebookDocumentVersion   NotebookDocumentVersion @relation(fields: [notebookDocumentVersionId], references: [id], onDelete: Cascade)
  paperAsset                PaperAsset              @relation(fields: [paperAssetId], references: [id], onDelete: Cascade)

  @@unique([notebookDocumentVersionId, paperAssetId])
}

model ProjectDoc {
  id              String              @id @default(cuid())
  projectId       String
  createdByUserId String
  title           String
  publishState    PublishState        @default(draft)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User                @relation("ProjectDocCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions        ProjectDocVersion[]
}

model ProjectDocVersion {
  id            String               @id @default(cuid())
  projectDocId  String
  versionNumber Int
  snapshot      String
  createdAt     DateTime             @default(now())
  projectDoc    ProjectDoc           @relation(fields: [projectDocId], references: [id], onDelete: Cascade)
  citations     ProjectDocCitation[]

  @@unique([projectDocId, versionNumber])
}

model ProjectDocCitation {
  id                  String            @id @default(cuid())
  projectDocVersionId String
  paperAssetId        String
  evidenceSpan        String?
  createdAt           DateTime          @default(now())
  projectDocVersion   ProjectDocVersion @relation(fields: [projectDocVersionId], references: [id], onDelete: Cascade)
  paperAsset          PaperAsset        @relation(fields: [paperAssetId], references: [id], onDelete: Cascade)

  @@unique([projectDocVersionId, paperAssetId])
}

model ProviderCredential {
  id            String    @id @default(cuid())
  userId         String
  provider       String
  secretRef      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs           Job[]

  @@index([userId, provider])
}

model Job {
  id                String        @id @default(cuid())
  spaceId           String
  requestedByUserId String
  credentialRef     String
  kind              String
  status            JobStatus
  payload           String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  space             Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  requestedBy       User          @relation("JobRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  providerCredential ProviderCredential @relation(fields: [credentialRef], references: [id], onDelete: Restrict)
  events            JobEvent[]
  auditLogs         AuditLog[]

  @@index([spaceId, requestedByUserId])
  @@index([requestedByUserId])
}

model JobEvent {
  id          String    @id @default(cuid())
  jobId        String
  status       JobStatus
  message      String
  recordedAt   DateTime  @default(now())
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model AuditLog {
  id          String    @id @default(cuid())
  spaceId      String
  actorUserId  String
  jobId        String?
  action       String
  detail       String
  recordedAt   DateTime  @default(now())
  space        Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  actor        User      @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  job          Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([spaceId, actorUserId])
}
