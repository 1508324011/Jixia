# Copy this file to .env for a runnable native demo on the current host.
# If your operator-owned paths differ, edit these values after copying.
# The current runtime persists state at JIXIA_STORAGE_ROOT/server-state.json.
# Keep JIXIA_DATABASE_URL available as a reserved runtime boundary for the next DB-backed phase.
JIXIA_STORAGE_ROOT=/home/zhurui/.local/share/jixia-demo/storage
JIXIA_DATABASE_URL=file:/home/zhurui/.local/share/jixia-demo/data/jixia-demo.db
JIXIA_HOST=127.0.0.1
JIXIA_PORT=3000
