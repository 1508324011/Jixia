# Copy this file to .env before editing values for your lab server runtime.
# Recommended persistent storage root: /var/lib/jixia/storage
# The current runtime persists legacy non-project state at JIXIA_STORAGE_ROOT/server-state.json.
# JIXIA_DATABASE_URL controls the SQLite database used for Prisma-backed Project and ProjectMember authority.
# Recommended persistent SQLite path in a durable data directory: file:/var/lib/jixia/data/jixia.db
# Typical host binding: use 127.0.0.1 for local-only runs or 0.0.0.0 inside Docker.
# Default runtime port: 3000
JIXIA_STORAGE_ROOT=YOUR_STORAGE_ROOT
JIXIA_DATABASE_URL=YOUR_DATABASE_URL
JIXIA_HOST=YOUR_SERVER_HOST
JIXIA_PORT=YOUR_SERVER_PORT
